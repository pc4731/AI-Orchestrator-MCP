# Build output
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Runtime data (SQLite db, generated workspaces, per-run quality tally, retrospective backlog).
# Root-anchored so these don't also match same-named SOURCE packages (e.g. com/orchestration/metrics).
/data/
*.db
/workspace/
/metrics/
/feedback/
# Learning loop: the raw proposals inbox + export packs are runtime; APPROVED lessons live in
# config/skills/learned/ (committed on purpose — that's the reviewed, portable change).
/learning/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Secrets
.env

# Build artifacts (produced by ./gradlew bootJar into build/libs)
/dist/
